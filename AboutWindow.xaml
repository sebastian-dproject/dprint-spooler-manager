<Window
  x:Class="DPrintSpoolerManager.AboutWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="About DPrint Spooler Manager"
  Width="400"
  Background="{DynamicResource PageBackground}"
  FontFamily="Segoe UI"
  ResizeMode="NoResize"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner">
  <Border
    Margin="16"
    Padding="22"
    Background="{DynamicResource CardBackground}"
    CornerRadius="12">
    <StackPanel>
      <TextBlock
        FontSize="20"
        FontWeight="Bold"
        Foreground="{DynamicResource PrimaryText}"
        Text="DPrint Spooler Manager" />
      <TextBlock
        Margin="0,4,0,18"
        FontSize="12"
        Foreground="{DynamicResource SecondaryText}"
        Text="Version 1.0.1" />
      <TextBlock
        Foreground="{DynamicResource PrimaryText}"
        Text="A lightweight Windows utility for monitoring and managing the Windows Print Spooler service and print queues."
        TextWrapping="Wrap" />
      <Separator Margin="0,18,0,14" />
      <TextBlock
        FontSize="10"
        FontWeight="Bold"
        Foreground="{DynamicResource SecondaryText}"
        Text="DEVELOPED BY" />
      <TextBlock
        Margin="0,4,0,12"
        FontSize="15"
        FontWeight="SemiBold"
        Foreground="{DynamicResource PrimaryText}"
        Text="Sebastian" />
      <TextBlock
        Foreground="{DynamicResource PrimaryText}"
        Text="Created with the assistance of OpenAI ChatGPT."
        TextWrapping="Wrap" />
      <TextBlock
        Margin="0,8,0,0"
        FontSize="11"
        Foreground="{DynamicResource SecondaryText}"
        Text="An independent project. OpenAI does not endorse or publish this application."
        TextWrapping="Wrap" />
      <Separator Margin="0,18,0,14" />
      <TextBlock
        FontSize="11"
        Foreground="{DynamicResource SecondaryText}"
        Text="Licensed under the Apache License, Version 2.0."
        TextWrapping="Wrap" />
      <TextBlock
        Margin="0,5,0,16"
        FontSize="11"
        Foreground="{DynamicResource SecondaryText}"
        Text="Copyright © 2026 Sebastian" />
      <Button
        MinWidth="90"
        MinHeight="36"
        Padding="12,6"
        HorizontalAlignment="Right"
        Background="{DynamicResource ButtonBackground}"
        BorderThickness="0"
        Click="CloseButton_Click"
        Content="CLOSE"
        Foreground="{DynamicResource ButtonForeground}" />
    </StackPanel>
  </Border>
</Window>
