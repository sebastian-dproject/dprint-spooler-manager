<Window
  x:Class="DPrintSpoolerManager.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="DPrint Spooler Manager"
  Width="700"
  Height="800"
  MinWidth="400"
  MinHeight="700"
  Background="{DynamicResource PageBackground}"
  Closing="Window_Closing"
  FontFamily="Segoe UI"
  Loaded="Window_Loaded"
  WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="5" />
    </Style>
    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="ButtonBorder"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderThickness="0"
              CornerRadius="8"
              Opacity="1"
              RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <!--  Subtle fade when the pointer enters the button.  -->
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="ButtonBorder"
                        Storyboard.TargetProperty="Opacity"
                        To="0.86"
                        Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="ButtonBorder"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>

              <!--  Small press-in effect while the button is held down.  -->
              <Trigger Property="IsPressed" Value="True">
                <!--  Stronger visual feedback for quick clicks.  -->
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#64748B" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="ButtonBorder"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                        To="0.94"
                        Duration="0:0:0.05" />
                      <DoubleAnimation
                        Storyboard.TargetName="ButtonBorder"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                        To="0.94"
                        Duration="0:0:0.05" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation
                        Storyboard.TargetName="ButtonBorder"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                        To="1"
                        Duration="0:0:0.10" />
                      <DoubleAnimation
                        Storyboard.TargetName="ButtonBorder"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                        To="1"
                        Duration="0:0:0.10" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>

              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style
      x:Key="PrimaryButtonStyle"
      BasedOn="{StaticResource ActionButtonStyle}"
      TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style
      x:Key="DangerButtonStyle"
      BasedOn="{StaticResource ActionButtonStyle}"
      TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource DangerBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerForeground}" />
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!--  App header and theme toggle  -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        VerticalAlignment="Center"
        FontSize="16"
        FontWeight="Bold"
        Foreground="{DynamicResource PrimaryText}"
        Text="DPRINT SPOOLER MANAGER" />
      <Button
        x:Name="ThemeToggleButton"
        Grid.Column="1"
        MinHeight="34"
        Padding="12,6"
        Click="ThemeToggleButton_Click"
        Content="LIGHT MODE"
        Style="{StaticResource ActionButtonStyle}" />
    </Grid>

    <!--  Status cards  -->
    <Grid Grid.Row="1" Margin="-5,0,-5,7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock
            FontSize="10"
            FontWeight="Bold"
            Foreground="{DynamicResource SecondaryText}"
            Text="SPOOLER SERVICE" />
          <TextBlock
            x:Name="ServiceStatusText"
            Margin="0,7,0,0"
            FontSize="21"
            FontWeight="SemiBold"
            Foreground="#D97706"
            Text="Checking..." />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock
            FontSize="10"
            FontWeight="Bold"
            Foreground="{DynamicResource SecondaryText}"
            Text="PRINT QUEUES" />
          <TextBlock
            x:Name="TotalJobsText"
            Margin="0,7,0,0"
            FontSize="21"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryText}"
            Text="0" />
        </StackPanel>
      </Border>
    </Grid>
    <!--  Service controls  -->
    <Border
      Grid.Row="2"
      Margin="0,0,0,12"
      Style="{StaticResource CardStyle}">
      <StackPanel>
        <TextBlock
          Margin="0,0,0,8"
          FontSize="12"
          FontWeight="Bold"
          Foreground="{DynamicResource PrimaryText}"
          Text="SPOOLER CONTROLS" />
        <UniformGrid Columns="3">
          <Button
            x:Name="StartButton"
            Margin="4"
            Click="StartButton_Click"
            Content="START"
            Style="{StaticResource PrimaryButtonStyle}" />
          <Button
            x:Name="StopButton"
            Margin="4"
            Click="StopButton_Click"
            Content="STOP"
            Style="{StaticResource ActionButtonStyle}" />
          <Button
            x:Name="RestartButton"
            Margin="4"
            Click="RestartButton_Click"
            Content="RESTART"
            Style="{StaticResource ActionButtonStyle}" />
        </UniformGrid>
      </StackPanel>
    </Border>
    <!--  Operation state  -->
    <Border
      Grid.Row="3"
      Margin="0,0,0,12"
      Padding="12"
      Background="{DynamicResource SurfaceAlt}"
      CornerRadius="9">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
          x:Name="OperationText"
          Grid.Row="0"
          VerticalAlignment="Center"
          FontWeight="SemiBold"
          Foreground="{DynamicResource StatusIdle}"
          Text="Operation: Idle" />

        <ProgressBar
          x:Name="OperationProgress"
          Grid.Row="1"
          Height="5"
          Margin="0,8,0,0"
          IsIndeterminate="True"
          Visibility="Collapsed" />
      </Grid>
    </Border>
    <!--  Queue  -->
    <Border
      Grid.Row="4"
      Margin="0,0,0,12"
      Padding="15"
      Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="2,0,2,10">
          <TextBlock
            FontSize="12"
            FontWeight="Bold"
            Foreground="{DynamicResource PrimaryText}"
            Text="PRINT QUEUE" />
        </DockPanel>
        <DataGrid
          x:Name="QueueGrid"
          Grid.Row="1"
          SelectionChanged="QueueGrid_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn
              Width="150"
              Binding="{Binding Printer}"
              Header="Printer" />
            <DataGridTextColumn
              Width="100"
              Binding="{Binding Document}"
              Header="Document" />
            <DataGridTextColumn
              Width="100"
              Binding="{Binding User}"
              Header="User" />
            <DataGridTextColumn
              Width="100"
              Binding="{Binding Status}"
              Header="Status" />
            <DataGridTextColumn
              Width="70"
              Binding="{Binding Pages}"
              Header="Pages" />
            <DataGridTextColumn
              Width="100"
              Binding="{Binding Submitted}"
              Header="Submitted" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
    <!--  Queue actions  -->
    <Grid Grid.Row="5" Margin="-4,0,-4,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="ClearSelectedButton"
        Grid.Column="0"
        Margin="4"
        Click="ClearSelectedButton_Click"
        Content="CLEAR SELECTED JOB"
        IsEnabled="False"
        Style="{StaticResource ActionButtonStyle}" />
      <Button
        x:Name="ClearAllButton"
        Grid.Column="1"
        Margin="4"
        Click="ClearAllButton_Click"
        Content="CLEAR ALL QUEUES"
        IsEnabled="False"
        Style="{StaticResource DangerButtonStyle}" />
    </Grid>
    <!--  Refresh and log actions  -->
    <Grid Grid.Row="6" Margin="-4,0,-4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="ShowLogButton"
        Grid.Column="0"
        Margin="4"
        Click="ShowLogButton_Click"
        Content="SHOW LOG"
        Style="{StaticResource ActionButtonStyle}" />
      <Button
        x:Name="AutoRefreshButton"
        Grid.Column="1"
        Margin="4"
        Click="AutoRefreshButton_Click"
        Content="AUTO: ON"
        Style="{StaticResource PrimaryButtonStyle}" />
      <Button
        x:Name="RefreshNowButton"
        Grid.Column="2"
        Margin="4"
        Click="RefreshNowButton_Click"
        Content="REFRESH NOW"
        Style="{StaticResource ActionButtonStyle}" />
    </Grid>
  </Grid>
</Window>
